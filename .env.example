# Copy to .env and fill in. Never commit .env.
# Every key is optional: providers without a key are skipped automatically,
# and `enrich doctor` shows exactly what's on/off.

# Identifying contact used in outbound User-Agent headers (SEC EDGAR requires this).
CONTACT_EMAIL=you@example.com

# --- Google Sheet (Sheets API mode) ---
SHEET_ID=                    # your Google Sheet ID
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json   # gitignored

# --- Paid / credit providers ---
HUNTER_API_KEY=            # hunter.io — pattern detection + finder + verifier
ANYMAILFINDER_API_KEY=     # anymailfinder.com — pay-only-for-verified finder
APOLLO_API_KEY=            # apollo.io — people search (0-credit) + email reveals
EXA_API_KEY=               # exa.ai — long-tail neural search
MILLIONVERIFIER_API_KEY=   # millionverifier.com — primary verifier
REOON_API_KEY=             # reoon.com — free-tier verifier (600/mo)

# --- Free-tier helper APIs ---
SERPER_API_KEY=            # serper.dev — SERP for LinkedIn confirmation (2,500 free)
FIRECRAWL_API_KEY=         # firecrawl.dev — optional JS-page rendering

# --- LLM researcher (optional; --llm flag) ---
# With ANTHROPIC_API_KEY set: direct API (billed per use, real cost metered into the budget).
# Without it: falls back to the local `claude` CLI on your existing subscription ($0 marginal).
ANTHROPIC_API_KEY=
LLM_COST_ESTIMATE=0.30     # conservative pre-call budget reservation per company

# --- Budget guard ---
# Hard cap on paid API spend per `enrich run` (also configurable in config.yaml / --budget).
BUDGET_PER_RUN_USD=10.00

# --- Cost accounting overrides (USD per credit/query; defaults = paid-tier list prices) ---
# On free tiers set these to 0 so the budget guard doesn't count free credits as spend.
HUNTER_COST_PER_CREDIT=          # default 0.0245  ($49 / 2,000 credits)
APOLLO_COST_PER_CREDIT=          # default 0.02    (conservative; free tier = 0)
ANYMAIL_COST_PER_CREDIT=         # default 0.049   ($49 / 1,000, only charged on verified)
EXA_COST_PER_SEARCH=             # default 0.007   (covered by free credits initially)
MILLIONVERIFIER_COST_PER_CREDIT= # default 0.0039  ($39 / 10,000 pack)
SERPER_COST_PER_QUERY=           # default 0.001   (2,500 free first)
